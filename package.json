{
  "name": "trace-viewer",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "node --test",
    "test:browser": "playwright test",
    "test:browser:update": "playwright test --update-snapshots",
    "test:production": "playwright test --config=playwright.production.config.js",
    "test:producer": "python3 -m unittest discover -s producer/tests -p 'test_*.py'",
    "test:all": "npm test && npm run test:producer",
    "benchmark:large": "node --expose-gc scripts/performance-fixture.mjs 100000",
    "pack:source": "python3 scripts/pack_source.py"
  },
  "dependencies": {
    "dompurify": "^3.4.12",
    "highlight.js": "^11.11.1",
    "marked": "^15.0.8",
    "mathjax-full": "3.2.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.1",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "vite": "^6.2.0"
  }
}
