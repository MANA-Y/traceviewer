{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://traceviewer.dev/schema/trace-v2.json",
  "title": "Trace Viewer Trace",
  "description": "Canonical snapshot format consumed by Trace Viewer. Unique frames, rendering lists, and output strings are stored once in lookup tables; steps refer to them by index.",
  "type": "object",
  "required": ["formatVersion", "files", "frames", "renderings", "outputs", "steps"],
  "properties": {
    "formatVersion": { "const": 2 },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 10000,
      "additionalProperties": { "type": "string" }
    },
    "frames": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/frame" }
    },
    "renderings": {
      "type": "array",
      "maxItems": 1000000,
      "items": {
        "type": "array",
        "items": { "$ref": "#/$defs/rendering" }
      }
    },
    "outputs": {
      "type": "array",
      "maxItems": 1000000,
      "items": { "type": "string" }
    },
    "presentationSteps": {
      "description": "Strictly increasing raw step indexes for the first visit to each authored line in rendering-producing functions, plus repeated visits that produce renderings. Internal helper execution and loop repetitions are omitted.",
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "type": "integer", "minimum": 0 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000000,
      "items": { "$ref": "#/$defs/step" }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "frame": {
      "type": "object",
      "required": ["path", "line_number", "function_name"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "line_number": { "type": "integer", "minimum": 1 },
        "function_name": { "type": "string" },
        "code": { "type": "string" },
        "invocation_id": { "type": ["integer", "string", "null"] }
      },
      "additionalProperties": true
    },
    "rendering": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "type": "string", "minLength": 1 },
        "data": { "type": ["string", "null"] },
        "language": { "type": ["string", "null"] },
        "style": { "type": ["object", "null"] },
        "external_link": { "type": ["object", "null"] },
        "internal_link": { "type": ["object", "null"] },
        "alt": { "type": ["string", "null"] },
        "focus": { "type": ["object", "null"] },
        "overlays": {
          "type": ["array", "null"],
          "items": { "type": "object" }
        }
      },
      "additionalProperties": true
    },
    "step": {
      "description": "[frame indexes, renderings index, stdout index, stderr index, environment delta]",
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "type": "array",
          "minItems": 1,
          "maxItems": 1000,
          "items": { "type": "integer", "minimum": 0 }
        },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "integer", "minimum": 0 },
        { "type": "object" }
      ]
    }
  }
}
